#include <stdio.h>
#include <string.h>

int main() {
    char str[100], rev[100];
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);
    str[strcspn(str, "\n")] = 0;

    strcpy(rev, str);
    strrev(rev);

    if (strcmp(str, rev) == 0) {
        printf("The string is a Palindrome.\n");
    } else {
        printf("The string is not a Palindrome.\n");
    }

    return 0;
}
